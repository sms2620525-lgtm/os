#!/bin/sh
# ARM64 images (Apple Silicon VMs, ARM laptops): install Hangover = Wine + FEX/box64 so
# x86 and x64 Windows programs run. Native ARM64 Windows programs use plain Wine.
set -e
[ "$(dpkg --print-architecture)" = arm64 ] || exit 0
sh /opt/fenestra-src/fenestra/compat/setup-arm64.sh || \
    echo "warning: Hangover could not be installed; x86 .exe files will need 'sudo fenestra-compat setup-arm'"
